# 1. Define the RK4 Step (Matches Simple_RK4 logic)
def rk4_step(f, t, y, h, *args):
    k1 = np.array(f(t, y, *args))
    k2 = np.array(f(t + h/2, y + h/2 * k1, *args))
    k3 = np.array(f(t + h/2, y + h/2 * k2, *args))
    k4 = np.array(f(t + h, y + h * k3, *args))
    return y + (h/6) * (k1 + 2*k2 + 2*k3 + k4)

# 2. Integrate the SIRHD system
# We use the parameters estimated by the PINN (e.g., beta_hat, gamma_hat)
