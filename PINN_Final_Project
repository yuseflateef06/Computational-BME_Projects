"""## Problem 3 a: SIRHD system of ODEs

From Problem 2, insert the **NORMALIZED** right-hand-side of the system of equations. The first equation is given as an example.
"""

def sirhd_rhs(t, y, beta, gamma, rho, mu, alpha, nu):
    """Right-hand side of the normalized SIRHD system (fractions)."""
    s, i, r, h, d = y
    ##---------------------------------------------------------------------------------------------
    ds = -beta * N * s * i + alpha * r
    di =  beta * N * s * i - (gamma + rho) * i
    dr =  gamma * i + nu * h - alpha * r
    dh =  rho * i - (nu + mu) * h
    dd =  mu * h
    ##---------------------------------------------------------------------------------------------
    return [ds, di, dr, dh, dd]

