from scipy.integrate import solve_ivp


def lhs_1d(num_points, lb=0.0, ub=1.0, seed=42):
    """Simple 1-D Latin Hypercube Sampling mapped to [lb, ub]."""
    rng = np.random.default_rng(seed)
    u = (np.arange(num_points, dtype=np.float32) + rng.random(num_points, dtype=np.float32)) / num_points
    rng.shuffle(u)
    return (lb + (ub - lb) * u).reshape(-1, 1).astype(np.float32)



def solve_sirhd(ODEs, beta, gamma, rho, mu, alpha, nu, t_eval, y0):
    """Solve the SIRHD ODE on t_eval."""
    sol = solve_ivp(
        fun=lambda t, y: ODEs(t, y, beta, gamma, rho, mu, alpha, nu),
        t_span=(float(t_eval[0]), float(t_eval[-1])),
        y0=y0,
        t_eval=t_eval,
        method="RK45",
        rtol=1e-7,
        atol=1e-9,
    )
    return sol.y  # shape (5, len(t_eval))


