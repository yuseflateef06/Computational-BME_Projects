"""## Problem 4: PINNs Model Definition

We define two classes:

- **`StateNetwork`**: a fully connected neural network that takes the scaled time $\tau \in [0,1]$ as input and outputs 5 logits. A **softmax** activation is applied so the outputs are automatically positive and sum to 1, enforcing $s + i + r + h + d = 1$ by construction.

- **`SIRHDPINN`**: wraps `StateNetwork` and adds six **trainable scalar parameters** $\beta, \gamma, \rho, \mu, \alpha, \nu$. Each raw parameter is passed through a **sigmoid** and then mapped linearly into its known physical range, so the PINN can never predict a physically impossible parameter value.

Follow the instruction in the hand out and below and answer Problem a, b, and c.
"""

class StateNetwork(nn.Module):
    """Maps scaled time tau -> 5 compartment fractions (s, i, r, h, d) via softmax."""

    def __init__(self, num_hidden_layers, neurons_per_layer):
        super().__init__()
        layers = []
        in_dim = 1
        for _ in range(num_hidden_layers):
            layers.append(nn.Linear(in_dim, neurons_per_layer))
            layers.append(nn.Tanh())
            in_dim = neurons_per_layer
        layers.append(nn.Linear(in_dim, 5))   # 5 outputs: one per compartment
        self.net = nn.Sequential(*layers)

    def forward(self, tau):
        logits = self.net(tau)
        probs  = torch.softmax(logits, dim=1)  # enforces positivity and sum = 1
        return probs


class SIRHDPINN(nn.Module):
    """PINN for SIRHD: neural network states + six trainable bounded parameters."""

    def __init__(self, num_hidden_layers, neurons_per_layer):
        super().__init__()
        self.state_net = StateNetwork(num_hidden_layers, neurons_per_layer)

        # Raw unconstrained parameters; mapped to physical ranges via sigmoid below
        self.beta_raw  = nn.Parameter(torch.tensor(0.0))
        self.gamma_raw = nn.Parameter(torch.tensor(0.0))
        self.rho_raw   = nn.Parameter(torch.tensor(0.0))

        ##---------------------------------------------------------------------------------------------
        ### Problem 4 a)
        ### Define the new parameters here (mu, alpha, nu) as raw unconstrained parameters
        ### follow the pattern above for beta, gamma, rho
        ##---------------------------------------------------------------------------------------------
        self.mu_raw    = nn.Parameter(torch.tensor(0.0))
        self.alpha_raw = nn.Parameter(torch.tensor(0.0))
        self.nu_raw    = nn.Parameter(torch.tensor(0.0))
        ##---------------------------------------------------------------------------------------------

    @staticmethod
    def _map_to_range(raw, lo, hi):
        """sigmoid maps (-inf,+inf) -> (0,1); then scale to (lo, hi)."""
        return lo + (hi - lo) * torch.sigmoid(raw)

    @property
    def beta(self):
        return self._map_to_range(self.beta_raw,  *PARAM_BOUNDS["beta"])

    @property
    def gamma(self):
        return self._map_to_range(self.gamma_raw, *PARAM_BOUNDS["gamma"])

    @property
    def rho(self):
        return self._map_to_range(self.rho_raw,   *PARAM_BOUNDS["rho"])

    ##---------------------------------------------------------------------------------------------
    ### Problem 4 b)
    ### Define the mapping for the parameters (mu, alpha, nu) here, following the pattern above
    ### the parameter mu is given as an example; follow the same pattern for alpha and nu
    ##---------------------------------------------------------------------------------------------
    @property
    def mu(self):
        return self._map_to_range(self.mu_raw,    *PARAM_BOUNDS["mu"])

    @property
    def alpha(self):
        return self._map_to_range(self.alpha_raw, *PARAM_BOUNDS["alpha"])

    @property
    def nu(self):
        return self._map_to_range(self.nu_raw, *PARAM_BOUNDS["nu"])
    ##---------------------------------------------------------------------------------------------


    ### Problem 4 c)
    ### add the output for the compartments h and d by following the same pattern as in s, i, r
    def states(self, tau):
        """Return (s, i, r, h, d) tensors for input tau."""
        out = self.state_net(tau)
        s = out[:, 0:1]
        i = out[:, 1:2]
        r = out[:, 2:3]
        ##---------------------------------------------------------------------------------------------
        h = out[:, 3:4]
        d = out[:, 4:5]
        ##---------------------------------------------------------------------------------------------
        return s, i, r, h, d

"""## Problem 5: Setup Network Architecture and Training Data

Define the parameters **num_hidden_layers, neurons_per_layer, epochs,** and **learning_rate**.

We prepare the tensors that will be used during training:

- **Data tensors** (`t_obs_t`, `i_obs_t`, `h_obs_t`, `d_obs_t`): the sparse noisy observations, with time scaled to $[0, 1]$.
- **Collocation points** (`t_f_t`): points at which the ODE residuals are evaluated. These are sampled with Latin Hypercube Sampling across the full domain $[0, 1]$ and require gradients so we can compute $d/d\tau$ via automatic differentiation.
- **Initial condition tensor** (`t0_t`): scaled time $\tau = 0$, used to enforce the initial conditions.
"""

##---------------------------------------------------------------------------------------------
# Architecture controls
num_hidden_layers  = 4
neurons_per_layer  = 32
##---------------------------------------------------------------------------------------------

##---------------------------------------------------------------------------------------------
# Training controls
epochs        = 50000
learning_rate = 1e-3
##---------------------------------------------------------------------------------------------


N_f           = 700      # number of collocation (physics) points
w_data        = 1.0      # weight for data loss
w_phys        = 1.0      # weight for physics (ODE residual) loss
w_ic          = 5.0      # weight for initial condition loss
w_cons        = 0.1      # weight for conservation loss (diagnostic)

# Device
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")

# Time span and scaling
t_span = t1_val - t0_val  # = 80.0

# Scale observation times to [0, 1]
t_obs_scaled = ((t_obs - t0_val) / t_span).reshape(-1, 1).astype(np.float32)

# Convert observations to PyTorch tensors
t_obs_t = torch.tensor(t_obs_scaled,              dtype=torch.float32, device=device)
i_obs_t = torch.tensor(i_obs.reshape(-1, 1),      dtype=torch.float32, device=device)
h_obs_t = torch.tensor(h_obs.reshape(-1, 1),      dtype=torch.float32, device=device)
d_obs_t = torch.tensor(d_obs.reshape(-1, 1),      dtype=torch.float32, device=device)

# Collocation points for the physics loss (requires_grad for autograd)
t_f_np = lhs_1d(N_f, lb=0.0, ub=1.0, seed=seed + 999)
t_f_t  = torch.tensor(t_f_np, dtype=torch.float32, device=device, requires_grad=True)

# Initial condition: tau = 0
t0_t  = torch.zeros((1, 1), dtype=torch.float32, device=device)
y0_t  = torch.tensor(y0_frac, dtype=torch.float32, device=device).view(1, 5)  # [s0, i0, r0, h0, d0]

print(f"Observation points   : {t_obs_t.shape[0]}")
print(f"Collocation points   : {t_f_t.shape[0]}")

"""## Problem 6: Create Model and Train

The total loss has four parts:

$$
\mathcal{L} = w_{\text{data}}\,\mathcal{L}_{\text{data}} + w_{\text{phys}}\,\mathcal{L}_{\text{phys}} + w_{\text{ic}}\,\mathcal{L}_{\text{ic}} + w_{\text{cons}}\,\mathcal{L}_{\text{cons}},
$$

where:

- $\mathcal{L}_{\text{data}}$: mean squared error between the predicted $i, h, d$ and the noisy observations.
- $\mathcal{L}_{\text{phys}}$: mean squared ODE residuals for all five equations, evaluated at the collocation points using automatic differentiation.
- $\mathcal{L}_{\text{ic}}$: mean squared error at $\tau = 0$ for all five compartments.
- $\mathcal{L}_{\text{cons}}$: penalty on violations of $s + i + r + h + d = 1$ (should be near zero since softmax already enforces this).

You should define the $\mathcal{L}_{\text{data}}$ and $\mathcal{L}_{\text{phys}}$ based on the available data and system of equations.
"""

model = SIRHDPINN(
    num_hidden_layers=num_hidden_layers,
    neurons_per_layer=neurons_per_layer,
).to(device)

optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)

history = {
    "total": [], "data": [], "phys": [], "ic": [], "cons": [],
    "beta": [], "gamma": [], "rho": [], "mu": [], "alpha": [], "nu": [],
}

for epoch in range(1, epochs + 1):
    optimizer.zero_grad()

    ##---------------------------------------------------------------------------------------------
    ### Problem 6 a) define the data loss based on the generated synthetic data from Problem 3 c.
    ##---------------------------------------------------------------------------------------------
    # -- Data loss (only I, H, D are observed)
    _, i_pred_obs, _, h_pred_obs, d_pred_obs = model.states(t_obs_t)
    data_loss = torch.mean((i_pred_obs - i_obs_t)**2) + \
                torch.mean((h_pred_obs - h_obs_t)**2) + \
                torch.mean((d_pred_obs - d_obs_t)**2)


    ##---------------------------------------------------------------------------------------------

    # -- Physics loss (ODE residuals at collocation points)
    s, i, r, h, d = model.states(t_f_t)

    # Compute d/d_tau via automatic differentiation
    ds_dtau = torch.autograd.grad(s, t_f_t, grad_outputs=torch.ones_like(s), create_graph=True, retain_graph=True)[0]
    di_dtau = torch.autograd.grad(i, t_f_t, grad_outputs=torch.ones_like(i), create_graph=True, retain_graph=True)[0]
    dr_dtau = torch.autograd.grad(r, t_f_t, grad_outputs=torch.ones_like(r), create_graph=True, retain_graph=True)[0]
    dh_dtau = torch.autograd.grad(h, t_f_t, grad_outputs=torch.ones_like(h), create_graph=True, retain_graph=True)[0]
    dd_dtau = torch.autograd.grad(d, t_f_t, grad_outputs=torch.ones_like(d), create_graph=True, retain_graph=True)[0]

    # Chain rule: d/dt = (1 / t_span) * d/d_tau
    scale  = 1.0 / t_span
    ds_dt  = ds_dtau * scale
    di_dt  = di_dtau * scale
    dr_dt  = dr_dtau * scale
    dh_dt  = dh_dtau * scale
    dd_dt  = dd_dtau * scale

    beta  = model.beta
    gamma = model.gamma
    rho   = model.rho
    mu    = model.mu
    alpha = model.alpha
    nu    = model.nu

    ##---------------------------------------------------------------------------------------------
    ### Problem 6 b) define the ODE residuals
    ##---------------------------------------------------------------------------------------------
    f_s = ds_dt - (-beta * N * s * i + alpha * r)
    f_i = di_dt - (beta * N * s * i - (gamma + rho) * i)
    f_r = dr_dt - (gamma * i + nu * h - alpha * r)
    f_h = dh_dt - (rho * i - (nu + mu) * h)
    f_d = dd_dt - (mu * h)
    ##---------------------------------------------------------------------------------------------

    ##---------------------------------------------------------------------------------------------
    ### Problem 6 c) define the phys_loss based on the ODE residuals defined above
    ##---------------------------------------------------------------------------------------------
    phys_loss = torch.mean(f_s**2 + f_i**2 + f_r**2 + f_h**2 + f_d**2)



    ##---------------------------------------------------------------------------------------------

    # -- Initial condition loss (all five compartments at tau = 0)
    s0, i0, r0, h0, d0 = model.states(t0_t)
    y0_pred = torch.cat([s0, i0, r0, h0, d0], dim=1)
    ic_loss = torch.mean((y0_pred - y0_t) ** 2)

    # -- Conservation loss (s + i + r + h + d = 1)
    cons_loss = torch.mean((s + i + r + h + d - 1.0) ** 2)

    # -- Total loss
    total_loss = w_data * data_loss + w_phys * phys_loss + w_ic * ic_loss + w_cons * cons_loss

    # Compute gradients and update parameters
    total_loss.backward()
    optimizer.step()

    # Record history
    history["total"].append(total_loss.item())
    history["data"].append(data_loss.item())
    history["phys"].append(phys_loss.item())
    history["ic"].append(ic_loss.item())
    history["cons"].append(cons_loss.item())
    history["beta"].append(beta.item())
    history["gamma"].append(gamma.item())
    history["rho"].append(rho.item())
    history["mu"].append(mu.item())
    history["alpha"].append(alpha.item())
    history["nu"].append(nu.item())

    if epoch % 100 == 0 or epoch == 1:
        print(f"Epoch {epoch:6d} | Total {total_loss.item():.3e} | Data {data_loss.item():.3e} | "
              f"Phys {phys_loss.item():.3e} | IC {ic_loss.item():.3e}")

