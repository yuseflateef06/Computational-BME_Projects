Y_rk4 = np.zeros((5, len(t_eval))) # 5 rows for S, I, R, H, D
Y_rk4[:, 0] = y0_frac # Initial conditions from the project

for n in range(len(t_eval) - 1):
    Y_rk4[:, n+1] = rk4_step(sirhd_rhs, t_eval[n], Y_rk4[:, n], h,
                             beta_hat, gamma_hat, rho_hat, mu_hat, alpha_hat, nu_hat)

